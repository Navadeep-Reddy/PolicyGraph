generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PolicyVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ArtifactType {
  FORM
  PROCEDURE
  CHECKLIST
  TRAINING_MATERIAL
  DEPARTMENT_INSTRUCTION
  INFORMATION_SHEET
}

enum DependencyNodeType {
  CLAUSE
  ARTIFACT
}

enum EdgeRelationship {
  GOVERNS
  UPDATES
  APPEARS_IN
}

enum EdgeStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PROPOSED
  CONFIRMED
  DISMISSED
  RESOLVED
}

enum DependencyOrigin {
  AI
  MANUAL
}

model Policy {
  id             String           @id @default(cuid())
  title          String
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  versions       PolicyVersion[]
  dependencyEdges DependencyEdge[]
}

model PolicyVersion {
  id            String              @id @default(cuid())
  policyId      String
  policy        Policy              @relation(fields: [policyId], references: [id], onDelete: Cascade)
  versionNumber Int
  status        PolicyVersionStatus
  publishedAt   DateTime?
  createdAt     DateTime            @default(now())
  clauses       Clause[]
  targetImpactRuns ImpactRun[]      @relation("TargetVersion")
  baseImpactRuns ImpactRun[]        @relation("BaseVersion")

  @@unique([policyId, versionNumber])
}

model Clause {
  id              String        @id @default(cuid())
  policyVersionId String
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  stableKey       String
  title           String
  text            String
  category        String
  position        Int
  textHash        String

  @@unique([policyVersionId, stableKey])
}

model Artifact {
  id            String           @id @default(cuid())
  name          String
  type          ArtifactType
  department    String
  description   String?
  content       String?
  impactResults ImpactResult[]
  sourceEdges   DependencyEdge[] @relation("SourceArtifact")
  targetEdges   DependencyEdge[] @relation("TargetArtifact")
}

model DependencyEdge {
  id                String             @id @default(cuid())
  policyId          String
  policy            Policy             @relation(fields: [policyId], references: [id], onDelete: Cascade)
  sourceType        DependencyNodeType
  sourceClauseKey   String?
  sourceArtifactId  String?
  sourceArtifact    Artifact?          @relation("SourceArtifact", fields: [sourceArtifactId], references: [id], onDelete: Cascade)
  targetArtifactId  String
  targetArtifact    Artifact           @relation("TargetArtifact", fields: [targetArtifactId], references: [id], onDelete: Cascade)
  relationshipType  EdgeRelationship
  status            EdgeStatus
  origin            DependencyOrigin
  rationale         String?

  @@index([policyId, status])
  @@index([sourceType, sourceClauseKey])
  @@index([sourceArtifactId])
  @@index([targetArtifactId])
}

model ImpactRun {
  id              String        @id @default(cuid())
  policyVersionId String
  policyVersion   PolicyVersion @relation("TargetVersion", fields: [policyVersionId], references: [id], onDelete: Cascade)
  baseVersionId   String
  baseVersion     PolicyVersion @relation("BaseVersion", fields: [baseVersionId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  results         ImpactResult[]
}

model ImpactResult {
  id               String       @id @default(cuid())
  impactRunId      String
  impactRun        ImpactRun    @relation(fields: [impactRunId], references: [id], onDelete: Cascade)
  changedClauseKey String
  artifactId       String
  artifact         Artifact     @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  distance         Int
  pathJson         Json
  reason           String
  reviewStatus     ReviewStatus @default(PROPOSED)
  reviewComment    String?

  @@unique([impactRunId, changedClauseKey, artifactId])
}
