{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "master",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "allow",
    "task": "allow",
    "skill": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny",
    "doom_loop": "ask"
  },
  "agent": {
    "master": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "description": "Senior architect, planner, reviewer, and decision-maker for the CareSync monorepo. Delegates reconnaissance to Explorer and bounded implementation to Implementer.",
      "permission": {
        "task": {
          "*": "deny",
          "explorer": "allow",
          "implementer": "allow"
        }
      }
    },
    "explorer": {
      "mode": "subagent",
      "model": "opencode/mimo-v2.6-flash-free",
      "description": "Read-only CareSync reconnaissance agent. Finds exact files, symbols, behavior, tests, dependencies, and likely change locations; does not implement or redesign.",
      "permission": {
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "grep *": "allow",
          "ls*": "allow",
          "npm test*": "allow",
          "npm run lint*": "allow"
        },
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny"
      }
    },
    "implementer": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "description": "Fast CareSync execution agent. Implements precise bounded tasks from Master in client or server, preserves conventions, runs requested validation, and reports blockers without redesigning scope.",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "task": "deny",
        "external_directory": "deny"
      }
    }
  }
}
